{
	"schemaVersion": 1,
	"id": "cozy-convenience",
	"version": "${version}",
	"name": "Cozy Convenience",
	"description": "Grab a seat, cuz we got lots of stuff, from blocks to plants to decor your world !",
	"authors": [
		"A pencil pal !"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "MIT",
	"icon": "assets/cozyconvene/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"pencil.cozyconvene.CozyConvenience"
		],
		"fabric-datagen": [
			"pencil.cozyconvene.CozyConvenienceDataGenerator"
		],
		"client": [
			"pencil.cozyconvene.CozyConvenienceClient"
		]
	},
	"mixins": [
		"cozy-convenience.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
